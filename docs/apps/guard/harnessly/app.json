{
  "id": "harnessly.guard",
  "name": "Стоп-кран",
  "description": "Останавливает опасные команды агента до запуска: rm -rf и git push --force",
  "version": "0.1.0",
  "harnessly": ">=0.16.177",
  "trust": "sandboxed",
  "targets": [
    "chat",
    "pane"
  ],
  "activation": {
    "on": [
      "manual"
    ]
  },
  "permissions": [
    "hooks.agent",
    "background"
  ],
  "agent": {
    "instructions": "instructions.md"
  },
  "views": [
    {
      "id": "main",
      "title": "Стоп-кран",
      "entry": "ui/index.html",
      "targets": [
        "pane"
      ]
    }
  ]
}
