{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Мудборд, версия 2",
  "type": "object",
  "required": ["cards"],
  "additionalProperties": false,
  "properties": {
    "cards": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 500 },
          "color": { "type": "string", "enum": ["yellow", "green", "blue", "pink"] }
        }
      }
    }
  }
}
