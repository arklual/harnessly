{
  "name": "harnessly-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Harnessly desktop shell (Electron): opens a Harnessly runtime or hub in a native window.",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "pnpm build && electron .",
    "dist": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "42.11.16",
    "electron-builder": "25.1.8",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
