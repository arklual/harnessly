# Copy to .env next to compose.yaml; `docker compose up -d --build` reads it. Nothing is published as an image yet, so
# the first start builds harnessly, boards and artifacts. Generate tokens with: openssl rand -hex 32
# Every token must be at least 16 characters. Left empty, a value falls back to a placeholder that is public knowledge:
# fine on your own machine, never on a server.

# --- Where people reach the three services -----------------------------------------------------------------------
# The addresses browsers use, without a trailing slash. The defaults are for one machine; on a server set all three
# (three hostnames under one registrable domain, TLS in front: docs/deploy.md, "A public server").
# HARNESSLY_PUBLIC_URL=https://example.com
# BOARDS_PUBLIC_URL=https://boards.example.com
# ARTIFACTS_PUBLIC_URL=https://docs.example.com
# Over https the preview slots need addresses of their own, 8 in slot order (docs/deploy.md, "The preview without a
# gateway").
# HARNESSLY_PREVIEW_PUBLIC_ORIGINS=https://p1.example-preview.com,...,https://p8.example-preview.com

# Host ports, all bound to 127.0.0.1 (a reverse proxy on the host publishes them).
# HARNESSLY_PORT=8022
# The 8 preview slots of the right pane's browser: the first port and the range, moved together.
# HARNESSLY_PREVIEW_PORT=8023
# HARNESSLY_PREVIEW_PORTS=8023-8030
# BOARDS_PORT=8081
# ARTIFACTS_PORT=8082
# MINIO_CONSOLE_PORT=9001

# --- First visit ------------------------------------------------------------------------------------------------
# Whoever opens the page first chooses the password. On a server set this: the page then asks for it before it lets
# anyone choose, so nobody else can claim the instance. At least 4 characters; the setup replaces it.
# INIT_PASSWORD=

# The name boards shows for you, and agents publish documents as "<name> (agent)".
# HARNESSLY_OWNER_NAME=Ada

# runtime: the default image; with-agents: Claude Code and Codex installed from npm (with the Node.js Codex needs).
# HARNESSLY_TARGET=with-agents

# --- Tokens -----------------------------------------------------------------------------------------------------
# boards: one token for the runtime (sign-in hand-offs), one for agents.
BOARDS_RUNTIME_TOKEN=
BOARDS_AGENT_TOKEN=
BOARDS_SESSION_SECRET=

# artifacts: the editor token agents publish with, the viewer token the runtime lists documents with (also what you
# paste when the document pane asks you to sign in).
ARTIFACTS_EDITOR_TOKEN=
ARTIFACTS_VIEWER_TOKEN=
ARTIFACTS_SECRET=

# --- Storage ----------------------------------------------------------------------------------------------------
# boards and artifacts keep their data on Docker volumes (fs). For S3 through the bundled MinIO, set both lines:
# COMPOSE_PROFILES=minio
# HARNESSLY_STORAGE=s3
# MinIO's credentials (also what boards and artifacts use to reach it):
MINIO_ROOT_USER=harnessly
MINIO_ROOT_PASSWORD=
# Any other S3 store: HARNESSLY_STORAGE=s3 and, for each service, the endpoint, bucket and keys, e.g.
# BOARDS_S3_ENDPOINT=https://s3.example.com  BOARDS_S3_BUCKET=boards
# BOARDS_S3_ACCESS_KEY_ID=…  BOARDS_S3_SECRET_ACCESS_KEY=…   (and the same four with ARTIFACTS_ in front)

# --- Images -----------------------------------------------------------------------------------------------------
# Build boards and artifacts from local checkouts instead of their repositories:
# BOARDS_SOURCE=../boards
# ARTIFACTS_SOURCE=../artifacts
# Use images published somewhere instead of building: name them, and let compose pull what it lacks.
# HARNESSLY_IMAGE=registry.example.com/harnessly:<tag>
# BOARDS_IMAGE=registry.example.com/boards:<tag>
# ARTIFACTS_IMAGE=registry.example.com/artifacts:<tag>
# HARNESSLY_PULL_POLICY=missing
