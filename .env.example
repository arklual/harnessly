# Copy to .env next to compose.yaml; `docker compose up` reads it. Generate tokens with: openssl rand -hex 32
# Every token must be at least 16 characters.

# HARNESSLY_PORT=8022
# BOARDS_PORT=8081
# ARTIFACTS_PORT=8082
# MINIO_CONSOLE_PORT=9001

# The name boards shows for you, and agents publish documents as "<name> (agent)".
# HARNESSLY_OWNER_NAME=Ada

# runtime: the default image; with-agents: Claude Code and Codex installed from npm.
# HARNESSLY_TARGET=with-agents

# boards: one token for the runtime (sign-in hand-offs), one for agents.
BOARDS_RUNTIME_TOKEN=
BOARDS_AGENT_TOKEN=
BOARDS_SESSION_SECRET=

# artifacts: the editor token agents publish with, the viewer token the runtime lists documents with (also what you
# paste when the document pane asks you to sign in).
ARTIFACTS_EDITOR_TOKEN=
ARTIFACTS_VIEWER_TOKEN=
ARTIFACTS_SECRET=

MINIO_ROOT_USER=harnessly
MINIO_ROOT_PASSWORD=

# Build boards and artifacts from local checkouts instead of their repositories:
# BOARDS_SOURCE=../boards
# ARTIFACTS_SOURCE=../artifacts
