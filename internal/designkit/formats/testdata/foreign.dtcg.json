{ "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "brand": { "$type": "color",
    "primary": { "$value": "#3b5bdb", "$description": "The primary action." },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.0941, 0.1137], "alpha": 1 }, "$description": "Body text." },
    "wash": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 } },
    "action": { "$value": "{brand.primary}", "$extensions": { "mode": { "dark": "{brand.ink}" } } } },
  "size": { "$type": "dimension",
    "base": { "$value": { "value": 4, "unit": "px" } },
    "gap": { "wide": { "$value": "24px" } } },
  "radii": { "$type": "dimension", "card": { "$value": "12px" } },
  "elevation": { "raised": { "$type": "shadow", "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } } },
  "font": { "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
            "scale": { "$type": "number", "ratio": { "$value": 1.25 } },
            "heading": { "h1": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontSize": "32px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" } } } },
  "motion": { "fast": { "$type": "duration", "$value": "120ms" } },
  "alias-to-number": { "$type": "dimension", "$value": "{font.scale.ratio}" } }
