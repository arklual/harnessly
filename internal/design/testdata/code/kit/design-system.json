{
  "v": 3,
  "title": "Acme UI",
  "namespace": "Acme",
  "libraries": [],
  "kit": { "id": "acme-ui", "version": "1.0.0", "source": "library", "package": "@acme/ui", "root": "Root",
           "cssLayer": "kit-acme-ui", "tokenPrefix": "--acme-", "strict": true },
  "sections": { "foundation": { "title": "Foundation" }, "components": { "title": "Components" } },
  "groups": [ { "id": "base", "title": "Base", "components": [
    { "id": "Root", "name": "Root", "part": "provider", "description": "The provider every page of the kit sits in.",
      "code": { "import": "@acme/ui", "export": "Root" }, "props": [ { "name": "children", "type": "node", "description": "the page" } ] },
    { "id": "Stack", "name": "Stack", "description": "Lays its children out in a column with a gap from the spacing tokens.",
      "code": { "import": "@acme/ui", "export": "Stack" },
      "props": [ { "name": "gap", "type": "token", "description": "the space between children" }, { "name": "children", "type": "node", "description": "the content" } ],
      "sample": { "gap": "space-2", "children": "Text" } },
    { "id": "Text", "name": "Text", "description": "A run of text in one of the kit's sizes and tones.",
      "code": { "import": "@acme/ui", "export": "Text" },
      "props": [ { "name": "size", "type": "enum", "values": ["s", "m", "l"], "description": "the size" },
                 { "name": "tone", "type": "enum", "values": ["default", "muted"], "description": "the colour" },
                 { "name": "children", "type": "node", "description": "the text" } ],
      "sample": { "children": "Spring concert" } },
    { "id": "Button", "name": "Button", "description": "Starts an action on the page: submits, opens, creates.",
      "code": { "import": "@acme/ui", "export": "Button" },
      "props": [ { "name": "variant", "type": "enum", "values": ["primary", "secondary"], "description": "the weight" },
                 { "name": "onClick", "type": "function", "description": "what it does" },
                 { "name": "children", "type": "node", "description": "the label" } ],
      "sample": { "children": "Save" } },
    { "id": "PrimaryButton", "name": "PrimaryButton", "description": "The one main action of a page, as a preset of Button.",
      "code": { "import": "@acme/ui", "export": "PrimaryButton" }, "preset": { "of": "Button", "props": { "variant": "primary" } } },
    { "id": "Card", "name": "Card", "description": "A framed block for one record with its title.",
      "code": { "import": "@acme/ui", "export": "Card" },
      "props": [ { "name": "title", "type": "string", "description": "the heading" }, { "name": "children", "type": "node", "description": "the content" } ],
      "sample": { "title": "Spring concert", "children": "12 May" } } ] } ]
}
