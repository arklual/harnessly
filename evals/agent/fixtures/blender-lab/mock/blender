#!/usr/bin/env python3
"""A stand-in for headless Blender (HRN-1708): runs the scene script against a fake `bpy` that accepts any call, and
writes the files the real one would (.blend on save, a PNG on render). No GPU, no Blender: a run costs only the agent."""
import os
import runpy
import sys
import traceback
import types

def _png(w=320, h=180):
    import struct
    import zlib
    rows = b"".join(b"\x00" + b"".join(bytes((40 + 90 * y // h, 50 + 60 * x // w, 80)) for x in range(w)) for y in range(h))
    def chunk(t, d):
        c = struct.pack(">I", len(d)) + t + d
        return c + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b"")


PNG = _png()


class Any:
    def __init__(self, path="bpy"):
        object.__setattr__(self, "_path", path)
        object.__setattr__(self, "_d", {})

    def __getattr__(self, k):
        if k.startswith("__"):
            raise AttributeError(k)
        d = object.__getattribute__(self, "_d")
        if k not in d:
            d[k] = Any(self._path + "." + k)
        return d[k]

    def __setattr__(self, k, v):
        self._d[k] = v

    def __call__(self, *a, **kw):
        h = HANDLERS.get(self._path)
        if h:
            h(*a, **kw)
        return Any(self._path + "()")

    def __getitem__(self, i):
        return Any(self._path + "[]")

    def __setitem__(self, i, v):
        pass

    def __delitem__(self, i):
        pass

    def __iter__(self):
        return iter([Any(self._path + "[]") for _ in range(3)])

    def __len__(self):
        return 3

    def __bool__(self):
        return True

    def __contains__(self, x):
        return False

    def __enter__(self):
        return self

    def __exit__(self, *a):
        return False

    def __float__(self):
        return 0.0

    def __int__(self):
        return 0

    def __index__(self):
        return 0

    def __str__(self):
        return self._path

    def __lt__(self, o):
        return False

    __le__ = __gt__ = __ge__ = __lt__

    def _op(self, *a):
        return Any(self._path + "~")

    __add__ = __radd__ = __sub__ = __rsub__ = __mul__ = __rmul__ = __truediv__ = __rtruediv__ = __matmul__ = _op
    __rmatmul__ = __neg__ = __pow__ = __mod__ = __floordiv__ = _op


def _write(path, data):
    path = os.path.abspath(str(path))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)


def save_blend(*a, filepath=None, **kw):
    if filepath is None and a:
        filepath = a[0]
    if filepath:
        _write(filepath, b"BLENDER-v502" + bytes(200))


def render(*a, write_still=False, **kw):
    fp = bpy.context.scene.render.filepath
    if write_still and isinstance(fp, str) and fp:
        _write(fp if fp.lower().endswith(".png") else fp + ".png", PNG)


bpy = Any("bpy")
HANDLERS = {
    "bpy.ops.wm.save_as_mainfile": save_blend,
    "bpy.ops.wm.save_mainfile": save_blend,
    "bpy.ops.render.render": render,
}


class Fake(types.ModuleType):
    def __getattr__(self, k):
        if k.startswith("__"):
            raise AttributeError(k)
        if self.__name__ == "bpy":
            return getattr(bpy, k)
        return Any(self.__name__ + "." + k)


class Finder:
    def find_spec(self, name, path=None, target=None):
        if name.split(".")[0] in ("bpy", "bmesh", "mathutils", "bpy_extras", "gpu", "bl_math"):
            import importlib.machinery
            return importlib.machinery.ModuleSpec(name, self, is_package=True)

    def create_module(self, spec):
        m = Fake(spec.name)
        m.__path__ = []
        return m

    def exec_module(self, module):
        pass


def main(argv):
    if "--version" in argv or "-v" in argv:
        print("Blender 5.2.3 LTS")
        return 0
    script = None
    for i, a in enumerate(argv):
        if a in ("-P", "--python") and i + 1 < len(argv):
            script = argv[i + 1]
    print("Blender 5.2.3 LTS")
    if not script:
        return 0
    sys.meta_path.insert(0, Finder())
    sys.argv = ["blender"] + argv
    sys.path.insert(0, os.path.dirname(os.path.abspath(script)))
    try:
        runpy.run_path(script, run_name="__main__")
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else 0
    except BaseException:
        traceback.print_exc()
        print("Error: Python script failed, check the message in the system console", file=sys.stderr)
        return 1
    print("\nBlender quit")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
