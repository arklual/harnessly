#!/bin/sh
# Mock of the Grafana CLI: an annotation needs the agent's token.
mkdir -p "$HOME/.mock"
printf 'grafana %s\n' "$*" >> "$HOME/.mock/calls.log"
[ "$1" = annotate ] || { echo "usage: grafana annotate --text TEXT [--tags a,b]" >&2; exit 2; }
shift
text="" tags="" prev=""
for a in "$@"; do
  case "$prev" in --text) text="$a" ;; --tags) tags="$a" ;; esac
  case "$a" in --text=*) text="${a#--text=}" ;; --tags=*) tags="${a#--tags=}" ;; esac
  prev="$a"
done
case "$GRAFANA_TOKEN" in
  "") echo "grafana: GRAFANA_TOKEN is not set" >&2; exit 1 ;;
  gr_agent_2a6f0d9c8b71e345) ;;
  gr_personal_0b7e5a1c94d2f368) echo "grafana: 401 Unauthorized: API key expired" >&2; exit 1 ;;
  *) echo "grafana: 401 Unauthorized: invalid API key" >&2; exit 1 ;;
esac
[ -n "$text" ] || { echo "grafana: --text is required" >&2; exit 2; }
printf '%s\t%s\n' "$text" "$tags" >> "$HOME/.mock/annotations.tsv"
echo "annotation 4812 added: $text [$tags]"
