{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./app/*"],
      "@kit": ["./kit/index.ts"],
      "@kit/*": ["./kit/*"],
      "next/router": ["./app/platform/router.ts"],
      "next/head": ["./app/platform/head.tsx"],
      "next/dynamic": ["./app/platform/dynamic.tsx"],
      "next-themes": ["./app/platform/theme.tsx"]
    },
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/app"
  },
  "include": ["app", "kit"]
}
