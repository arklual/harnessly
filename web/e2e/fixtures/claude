#!/bin/bash
# A stand-in for Claude Code: it answers --version, writes its transcript and session file where Claude does, plays
# the hooks of its --settings file, and answers every line typed into it with a tool call and a reply.
if [ "$1" = "--version" ]; then echo "2.1.99 (Claude Code)"; exit 0; fi
# The runtime tells an agent from a shell by the pane's command name (argv[0]): run as "claude", not "bash".
if [ -z "$FAKE_AGENT_NAMED" ]; then FAKE_AGENT_NAMED=1 exec -a claude /bin/bash "$0" "$@"; fi
echo "$*" >> "$HOME/claude-calls.log"
settings=""; sid=""; prompt=""
while [ $# -gt 0 ]; do
  case "$1" in
    --settings) settings="$2"; shift ;;
    --resume) sid="$2"; shift ;;
    # Everything after "--" is the first prompt, as the runtime launches a conversation started with a message.
    --) shift; prompt="$*"; break ;;
    --*) case "$2" in --*|"") ;; *) shift ;; esac ;;
    *) prompt="$1" ;;
  esac
  shift
done
[ -n "$sid" ] || sid=$(cat /proc/sys/kernel/random/uuid)
cwd=$(pwd)
project="$HOME/.claude/projects/$(printf '%s' "$cwd" | sed 's/[^A-Za-z0-9]/-/g')"
mkdir -p "$project" "$HOME/.claude/sessions"
transcript="$project/$sid.jsonl"
touch "$transcript"
printf '{"pid":%s,"sessionId":"%s","cwd":"%s","startedAt":%s000}\n' "$$" "$sid" "$cwd" "$(date +%s)" > "$HOME/.claude/sessions/$$.json"
hook() {
  [ -n "$settings" ] || return 0
  cmd=$(sed -n 's/^ *"command": "\(.*\)",\{0,1\}$/\1/p' "$settings" | sed 's/\\"/"/g' | grep -- "$1\$" | head -1)
  [ -n "$cmd" ] && eval "$cmd" > /dev/null 2>&1
}
# A JSON string body: backslashes, quotes, tabs and the newlines of a long first message escaped.
json() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'; }
now() { date -u +%Y-%m-%dT%H:%M:%S.000Z; }
# Milliseconds since the epoch, without a process per look (the date of some systems ignores %3N).
tick() { NOW=$(( ${EPOCHREALTIME/./} / 1000 )); }
# Lines typed while a turn runs wait in Claude's own queue (an `enqueue` record) and reach the agent at the end of its
# step as a `queued_command` attachment with a `remove`, no user record; the chord ctrl+x ctrl+s hands the running tool
# over, so they reach it now. The typed text shows in the box until its Enter, as in the real one.
held=(); heldat=(); inject_now=0
wait_for() {
  local ch rest limit
  tick; limit=$(( NOW + $1 ))
  while tick; [ "$NOW" -lt "$limit" ] && [ $inject_now = 0 ]; do
    IFS= read -rsn1 -t 0.1 ch || continue
    case "$ch" in
      $'\e') IFS= read -rsn5 -t 0.05 rest; case "$rest" in "[200~") pasting=1 ;; "[201~") pasting=0 ;; esac ;;
      $'\x18') ;;
      $'\x13') inject_now=1 ;;
      "")
        if [ $pasting = 1 ]; then buf="$buf"$'\n'; draw
        elif [ -n "$buf" ]; then
          held+=("$buf"); heldat+=("$(now)")
          printf '{"type":"queue-operation","operation":"enqueue","content":"%s","timestamp":"%s","sessionId":"%s"}\n' "$(json "$buf")" "$(now)" "$sid" >> "$transcript"
          buf=""; draw
        fi ;;
      *) buf="$buf$ch"; draw ;;
    esac
  done
}
deliver_held() {
  local i
  for i in "${!held[@]}"; do
    printf '{"type":"queue-operation","operation":"remove","content":"%s","timestamp":"%s","sessionId":"%s"}\n' "$(json "${held[$i]}")" "$(now)" "$sid" >> "$transcript"
    printf '{"type":"attachment","attachment":{"type":"queued_command","prompt":"%s","commandMode":"prompt","timestamp":"%s"},"uuid":"q-%s-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$(json "${held[$i]}")" "${heldat[$i]}" "$RANDOM" "$i" "$(now)" "$sid" "$cwd" >> "$transcript"
  done
}
# A message asking «askquestions» makes it call AskUserQuestion with two questions (one choice, then several) and wait
# on the dialog Claude draws: a digit picks or toggles, Right leaves the several-choice tab, «1» on the review submits.
# The answer reaches the transcript as the tool's result, and the agent says what it got.
ask_draw() {
  printf '\033[H\033[2J'
  if [ "$1" = 2 ]; then
    printf '  Review your answers\n\n  Which crust? -> %s\n  Which toppings? -> %s\n\n  Ready to submit your answers?\n\n' "$a1" "$a2"
    printf '❯ 1. Submit answers\n  2. Cancel\n'
    return
  fi
  if [ "$1" = 0 ]; then
    printf '← ☐ Which crust?  ☐ Which toppings?  ✔ Submit →\n\nWhich crust?\n\n❯ 1. Thin\n  2. Thick\n  3. Stuffed\n  4. Type something.\n'
  else
    printf '← ☒ Which crust?  ☐ Which toppings?  ✔ Submit →\n\nWhich toppings?\n\n❯ 1. [ ] Cheese\n  2. [ ] Olives\n  3. [ ] Basil\n  4. [ ] Type something.\n'
  fi
  printf '%s\n  5. Chat about this\nEnter to select · ↑/↓ to navigate · Esc to cancel\n' "$rule"
}
ask_turn() {
  local n="$1" step=0 ch rest crust=(Thin Thick Stuffed) top=(Cheese Olives Basil) picked=() i label
  a1=""; a2=""
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_%s","name":"AskUserQuestion","input":{"questions":[{"question":"Which crust?","header":"Crust","multiSelect":false,"options":[{"label":"Thin","description":"crisp"},{"label":"Thick","description":"soft"},{"label":"Stuffed","description":"cheesy"}]},{"question":"Which toppings?","header":"Toppings","multiSelect":true,"options":[{"label":"Cheese","description":"extra"},{"label":"Olives","description":"salty"},{"label":"Basil","description":"fresh"}]}]}}]},"uuid":"t-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$n" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  ask_draw 0
  while [ $step -lt 3 ]; do
    IFS= read -rsn1 ch || break
    if [ "$ch" = $'\e' ]; then
      IFS= read -rsn2 -t 0.2 rest
      [ "$rest" = "[C" ] && [ $step = 1 ] && [ ${#picked[@]} -gt 0 ] && { step=2; ask_draw 2; }
      continue
    fi
    case "$ch" in
      [1-3])
        i=$(( ch - 1 ))
        if [ $step = 0 ]; then a1="${crust[$i]}"; step=1; ask_draw 1
        elif [ $step = 1 ]; then
          label="${top[$i]}"
          if [[ " ${picked[*]} " == *" $label "* ]]; then
            local kept=(); for p in "${picked[@]}"; do [ "$p" != "$label" ] && kept+=("$p"); done; picked=("${kept[@]}")
          else picked+=("$label"); fi
          a2=$(IFS=,; printf '%s' "${picked[*]}" | sed 's/,/, /g')
          ask_draw 1
        fi ;;
    esac
    if [ $step = 2 ] && [ "$ch" = 1 ]; then step=3; fi
  done
  out="User has answered your questions: \"Which crust?\"=\"$a1\", \"Which toppings?\"=\"$a2\". You can now continue."
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_%s","content":"%s"}]},"uuid":"r-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$n" "$(printf '%s' "$out" | sed 's/\\/\\\\/g; s/"/\\"/g')" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  reply="Fake agent reply: got crust $a1 and toppings $a2"
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]},"uuid":"a-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$(json "$reply")" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  sleep 0.3
  echo "{\"session_id\":\"$sid\"}" | hook stop
}
turn() {
  text=$(json "$1"); n=$RANDOM
  printf '{"type":"user","message":{"role":"user","content":"%s"},"uuid":"u-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$text" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  echo "{\"session_id\":\"$sid\",\"prompt\":\"$text\"}" | hook prompt-submit
  held=(); heldat=(); inject_now=0
  # A message asking for a long task runs a tool for a while: its call stands in the transcript without a result.
  case "$1" in *long*) long=1 ;; *) long=0 ;; esac
  # The lesson videos ask for a long turn without the word in the message: a flag file beside the reply.
  [ -f "$HOME/.fake-long" ] && long=1
  if [ $long = 0 ]; then wait_for 1000; fi
  case "$1" in *askquestions*) ask_turn "$n"; return ;; esac
  # Asked for a widget, it draws one with the real CLI: «widget N» shows the number N in the widget «sales», so the
  # same message with another number changes that widget where it stands.
  command='ls -la'; widget=0
  case "$1" in *widget*) widget=$(printf '%s' "$1" | grep -o '[0-9][0-9]*' | head -1); widget=${widget:-1}
    command="harnessly widget render --title Sales --html @w.html --js @w.js --data @d.json --id sales" ;;
  esac
  if [ -f "$HOME/.fake-widget" ]; then widget=$(cat "$HOME/.fake-widget"); widget=${widget:-1}
    command="harnessly widget render --title Sales --html @w.html --js @w.js --data @d.json --id sales"; fi
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_%s","name":"Bash","input":{"command":"%s","description":"List files"}}]},"uuid":"t-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$n" "$command" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  if [ $long = 1 ]; then wait_for 20000; else wait_for 500; fi
  out='total 0'
  if [ "$widget" != 0 ]; then
    printf '<div class="stat" id="n"></div>' > "$HOME/w.html"
    printf 'document.getElementById("n").textContent = "Sales " + window.widgetData.n;' > "$HOME/w.js"
    printf '{"n":%s}' "$widget" > "$HOME/d.json"
    # The CLI lies beside this script: the pane's PATH is the login shell's.
    raw=$(cd "$HOME" && PATH="${BASH_SOURCE[0]%/*}:$PATH" $command 2>&1); out=$(json "$raw")
  fi
  case "$1" in *references*) out='total 0\nfixtures: https://gitlab.example.test/team/admin/-/merge_requests/502' ;; esac
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_%s","content":"%s"}]},"uuid":"r-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$n" "$out" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  deliver_held
  reply="Fake agent reply: $1"
  for h in "${held[@]}"; do reply="$reply"$'\n\n'"Fake agent reply: $h"; done
  # Asked for links, it answers with a document and a merge request, as an agent reports its work.
  # Asked for its references, it names a task, a site and, in a folder of many repositories, merge requests by their
  # project («model-gateway !104», «harnessly !80» that two projects have) and one that no project has (!999); a
  # link a tool printed (the grep) does not make a merge request of anyone.
  case "$1" in *references*) reply="Fake agent reply: ABC-12 is done, notes at https://example.com/notes. Merged model-gateway !104 and harnessly !80, !999 and !502 are typos." ;; esac
  case "$1" in *links*) reply="Fake agent reply: see [the release notes](https://docs.example.com/notes) and https://gitlab.com/acme/app/-/merge_requests/7" ;; esac
  # The documentation's screenshots (docs-shots.spec.ts) give it a real answer to show.
  if [ -f "$HOME/.fake-reply.md" ]; then reply=$(cat "$HOME/.fake-reply.md"); fi
  # Asked to draw, it does what the boards and artifacts skills do with the environment the runtime gave it: a board
  # from a graph and a document of this conversation, and it answers with their links.
  case "$1" in *draw*)
    if [ -n "$BOARDS_URL" ] && [ -n "$ARTIFACTS_URL" ]; then
      board=$(curl -fsS -X POST "$BOARDS_URL/b/api/boards" -H "Authorization: Bearer $BOARDS_TOKEN" -H 'Content-Type: application/json' \
        -d '{"title":"Checkout flow","graph":{"direction":"LR","nodes":[{"id":"cart","label":"Cart"},{"id":"pay","label":"Payment","color":"teal"},{"id":"done","label":"Receipt","color":"green"}],"edges":[{"from":"cart","to":"pay"},{"from":"pay","to":"done","label":"paid"}]}}' \
        | grep -o '"url":"[^"]*"' | head -1 | cut -d'"' -f4)
      doc=$(curl -fsS -X POST "$ARTIFACTS_URL/api/v1/artifacts" -H "Authorization: Bearer $ARTIFACTS_TOKEN" -H 'Content-Type: application/json' \
        -d "{\"title\":\"Checkout plan\",\"markdown\":\"# Checkout plan\\n\\nThe cart hands over to payment; a paid order gets its receipt.\",\"session\":\"$ARTIFACTS_SESSION\",\"author\":\"$ARTIFACTS_AUTHOR\"}" \
        | grep -o '"viewUrl": *"[^"]*"' | head -1 | sed 's/.*"\(http[^"]*\)"$/\1/')
      reply="Drew [the checkout flow]($board) and wrote the plan: $doc"
    fi ;;
  esac
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]},"uuid":"a-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' "$(json "$reply")" "$n" "$(now)" "$sid" "$cwd" >> "$transcript"
  sleep 0.3
  echo "{\"session_id\":\"$sid\"}" | hook stop
}
# A terminal like Claude Code's: an input box under a rule, what is typed shows in it (the tty does not echo), Enter
# submits it and the box is busy for the turn. A pasted text (bracketed paste) keeps its line breaks, as the real one does.
rule=$(printf '─%.0s' $(seq 1 80)); buf=""; shown=""; pasting=0; busy=0
draw() {
  printf '\033[H\033[2J'
  printf '  Claude Code v2.1.99\n  fake claude ready %s\n\n' "$sid"
  [ -n "$shown" ] && printf '%s\n' "$shown"
  [ $busy = 1 ] && printf '\n✻ Working… (esc to interrupt)\n'
  printf '\n%s\n❯ %s\n%s\n  ? for shortcuts\n' "$rule" "$buf" "$rule"
}
stty -echo 2>/dev/null
sleep 0.5
echo "{\"session_id\":\"$sid\"}" | hook session-start
draw
run() { busy=1; shown=""; draw; turn "$1"; busy=0; shown="● Fake agent reply: $1"; draw; }
[ -n "$prompt" ] && run "$prompt"
while IFS= read -rsn1 ch; do
  # Ctrl+D ends the session, as it does in the real one.
  [ "$ch" = $'\004' ] && exit 0
  if [ "$ch" = $'\e' ]; then
    IFS= read -rsn5 -t 0.05 rest
    case "$rest" in "[200~") pasting=1 ;; "[201~") pasting=0 ;; esac
    continue
  fi
  if [ -z "$ch" ]; then
    if [ $pasting = 1 ]; then buf="$buf"$'\n'; draw; continue; fi
    if [ -n "$buf" ]; then line="$buf"; buf=""; run "$line"; fi
    continue
  fi
  buf="$buf$ch"; draw
done
