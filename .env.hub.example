# Settings of the hub (docs/hub/deploy.md). For compose.hub.yaml copy this file to .env next to it, or to any name and
# pass `docker compose --env-file <name> -f compose.hub.yaml up -d --build`. Outside compose the same names are
# environment variables of `hub serve` (deploy/systemd/hub.env.example, deploy/helm/harnessly-hub). `hub check-config`
# prints what it understood, and never a secret.
# Only HUB_PUBLIC_URL is required. Everything else has a default that works on one machine.

# --- Where people reach the hub ------------------------------------------------------------------------------------
# The address in the browser, without a trailing slash: it is what sign-in providers call back, what machines dial and
# what the cookies are bound to. https on a server. If it is not set here, compose uses http://hub.localhost:$HUB_PORT
# (browsers send *.localhost to the loopback; the machine's container is told that the name is the hub).
# HUB_PUBLIC_URL=https://hub.example.com
# The port of the hub on the host, bound to 127.0.0.1 (a reverse proxy on the host publishes it).
# HUB_PORT=8040
# Addresses allowed to tell the hub the client's address in X-Forwarded-For (the reverse proxy in front), exactly those
# and no wider. Default in compose.hub.yaml: the gateway of the hub's network, which is where the reverse proxy on the
# host (it connects to the published port) comes from; the machine's container is another address and is not believed.
# HUB_TRUSTED_PROXIES=172.29.40.1/32
# The first three bytes of the addresses of the hub's network in compose.hub.yaml (a /24; the gateway is .1, the hub .2).
# Change it when 172.29.40.0/24 is already used on the host.
# HUB_NET=172.29.40

# --- Who may come in --------------------------------------------------------------------------------------------
# open: anyone can create an account; invite: only the administrators below and people with an invitation to a space.
# The hub's own default is open (one machine, one person); the Helm chart's and the compose file's is invite.
# HUB_SIGNUP=invite
# Administrators of the installation (only they can connect «Эта машина»); an address counts when the person proved it
# (the code from the mail, GitHub), not when a provider only says so. Empty: the first account to sign in becomes the
# administrator, and it has to prove its email as well. Name administrators on any server others can reach.
# HUB_ADMIN_EMAILS=you@example.com

# --- Sign-in ways -----------------------------------------------------------------------------------------------
# Email code: with a mail server the code is mailed, without one it is written to the hub's log, marked DEV: only on plain
# http. A hub on https needs the mail server (a code in a log is a sign-in as anyone who can read it); HUB_MAIL_LOG=allow
# accepts the log anyway, for a hub whose log is as private as its database.
# HUB_SMTP_URL=smtp://user:password@mail.example.com:587     (smtps:// for port 465)
# HUB_MAIL_LOG=allow
# HUB_MAIL_FROM=harnessly <no-reply@example.com>
# Passkeys need a domain name, not an IP address. HUB_RP_ID is the name passkeys are bound to (the host of
# HUB_PUBLIC_URL by default; set it to the parent domain to share passkeys between hosts).
# HUB_PASSKEY=on
# HUB_RP_ID=
# GitHub and Yandex ID show up on the sign-in page when both halves are set. Callback URLs:
#   <HUB_PUBLIC_URL>/api/auth/oauth/github/callback and <HUB_PUBLIC_URL>/api/auth/oauth/yandex/callback
# HUB_GITHUB_CLIENT_ID=
# HUB_GITHUB_CLIENT_SECRET=
# HUB_YANDEX_CLIENT_ID=
# HUB_YANDEX_CLIENT_SECRET=
# OpenID Connect: a list of ids and four settings per id (callback <HUB_PUBLIC_URL>/api/auth/oauth/<id>/callback). In
# compose.hub.yaml add the per-id lines under `environment:` of the hub service.
# HUB_OIDC_PROVIDERS=keycloak
# HUB_OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/team
# HUB_OIDC_KEYCLOAK_CLIENT_ID=harnessly
# HUB_OIDC_KEYCLOAK_CLIENT_SECRET=
# HUB_OIDC_KEYCLOAK_NAME=Corporate sign-in

# --- Machines ---------------------------------------------------------------------------------------------------
# Give every machine an address of its own, <machine>.<domain> (a wildcard DNS record and certificate for *.domain).
# Needed as soon as people other than you can run machines, and required by the cloud edition: without it a machine's
# pages are served from the hub's own origin (path mode) and can act as the person who opened them, so only machines
# you trust completely belong there: in path mode the hub opens only machines an administrator connected
# (docs/hub/deploy.md). Use a domain of its own, not a subdomain of the hub's
# (m.example.com next to hub.example.com is one site; hub.example.com and example-machines.com are two). The hub checks
# it with the public suffix list: a same-site domain is a warning; the cloud edition does not start with one unless
# HUB_ALLOW_SAME_SITE_RUNTIME=1; a parent of the hub's host is refused.
# HUB_RUNTIME_DOMAIN=example-machines.com
# HUB_ALLOW_SAME_SITE_RUNTIME=0
# The image the «В контейнере» way runs. It must be one the machines can pull; empty hides that way.
# HUB_CONTAINER_IMAGE=ghcr.io/ly-solutions/harnessly-machine:latest
# Refuse agents older than this version.
# HUB_MIN_AGENT_VERSION=
# The hub may connect to a server once over SSH to install a machine («Свой сервер по SSH»), with a key of the space's
# own that only its owners see; the owner confirms the server's host key first.
# HUB_SSH=on
# Let that way reach servers that are not on the public internet (private, loopback, link-local). Off by default, and
# ignored by the cloud edition.
# HUB_SSH_ALLOW_PRIVATE=off
# What the spaces' SSH keys are sealed with, at least 32 characters (openssl rand -base64 32). Empty: the hub makes a
# key file `secret_key` in its data folder. Losing it makes the stored SSH keys useless; they are made again.
# HUB_SECRET_KEY=
# The name of the local machine's container, as it shows in the hub (compose.hub.yaml).
# MACHINE_NAME=harnessly-local

# --- Storage and logs -------------------------------------------------------------------------------------------
# SQLite in the data folder is the default. For Postgres: postgres://user:password@host:5432/harnessly?sslmode=require
# HUB_DATABASE_URL=
# debug, info, warn or error.
# HUB_LOG_LEVEL=info

# --- Images (compose.hub.yaml builds them; set these to use published ones with HARNESSLY_PULL_POLICY=missing) ---------
# HUB_IMAGE=ghcr.io/ly-solutions/harnessly-hub:latest
# MACHINE_IMAGE=ghcr.io/ly-solutions/harnessly-machine:latest
# HARNESSLY_PULL_POLICY=never
