{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "docs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^$|^https?://[^/?#@\\s]+/?$" },
        "bundled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string" }, "tag": { "type": "string" } } },
        "storage": {
          "type": "object",
          "properties": {
            "type": { "enum": ["", "fs", "s3"] },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "s3": { "type": "object", "properties": { "existingSecret": { "type": "string" } } }
          }
        },
        "auth": { "enum": ["token", "harnessly"] },
        "frameAncestors": { "type": "array", "items": { "type": "string" } },
        "existingSecret": { "type": "string" },
        "ingress": { "type": "boolean" }
      }
    },
    "boards": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^$|^https?://[^/?#@\\s]+/?$" },
        "bundled": { "type": "boolean" },
        "image": { "type": "object", "properties": { "repository": { "type": "string" }, "tag": { "type": "string" } } },
        "storage": {
          "type": "object",
          "properties": {
            "type": { "enum": ["", "fs", "s3"] },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "s3": { "type": "object", "properties": { "existingSecret": { "type": "string" } } }
          }
        },
        "auth": { "enum": ["token", "harnessly"] },
        "frameAncestors": { "type": "array", "items": { "type": "string" } },
        "existingSecret": { "type": "string" },
        "ingress": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "publicUrl": {
      "type": "string",
      "description": "http(s)://host[:port], no path and no trailing slash. Required to render.",
      "pattern": "^$|^https?://[^/?#@\\s]+$"
    },
    "runtimeDomain": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$"
    },
    "sitesDomain": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$"
    },
    "sites": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "abuseUrl": { "type": "string", "pattern": "^$|^(https?://|mailto:)\\S+$" },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string", "pattern": "^$|^https?://[^/?#@\\s]+$" },
            "region": { "type": "string" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" }
          }
        }
      }
    },
    "signup": { "enum": ["open", "invite"] },
    "adminEmails": { "type": "array", "items": { "type": "string", "pattern": "^[^@\\s,]+@[^@\\s,]+$" } },
    "orgs": { "enum": ["off", "on"] },
    "featuresDefault": { "type": "array", "items": { "type": "string" } },
    "machineTrust": { "type": "boolean" },
    "oidcEmailTrusted": { "type": "boolean" },
    "edition": { "enum": ["self-hosted", "cloud"] },
    "passkey": { "type": "boolean" },
    "ssh": { "type": "boolean" },
    "sshAllowPrivate": { "type": "boolean" },
    "trustedProxies": {
      "type": "string",
      "description": "Comma-separated CIDRs or addresses of the ingress controller's pods; empty trusts nobody.",
      "pattern": "^$|^[0-9A-Fa-f:.]+(/[0-9]{1,3})?(\\s*,\\s*[0-9A-Fa-f:.]+(/[0-9]{1,3})?)*$"
    },
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "github": {
      "type": "object",
      "properties": { "clientId": { "type": "string" }, "url": { "type": "string" } }
    },
    "yandex": {
      "type": "object",
      "properties": { "clientId": { "type": "string" } }
    },
    "oidc": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issuer", "clientId"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "name": { "type": "string" },
          "issuer": { "type": "string", "pattern": "^https?://" },
          "clientId": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "secrets": { "type": "object", "additionalProperties": { "type": "string" } },
    "database": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "password": { "type": "string", "pattern": "^[A-Za-z0-9._~-]*$" },
            "existingSecret": { "type": "string" },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "not": { "enum": [8040, 8041] } },
        "from": { "type": "array", "items": { "type": "object" } }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "tls": { "type": "array" }
      }
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["", "Recreate", "RollingUpdate"] },
        "maxSurge": { "type": ["integer", "string"] }
      }
    },
    "drain": {
      "type": "object",
      "properties": {
        "settleSeconds": { "type": "integer", "minimum": 0 },
        "linksSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "preStop": { "type": "object" },
    "antiAffinity": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "topologyKey": { "type": "string" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 20 }
  }
}
