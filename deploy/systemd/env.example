# Environment of the harnessly user service (~/.config/harnessly/env); see docs/configuration.md for every variable.

# Where the page listens. Keep it on loopback and put a TLS proxy in front to reach it from elsewhere.
# RUNTIME_GATE_LISTEN=127.0.0.1:8022
# RUNTIME_WORKSPACE_DIR=/home/ada/src
# RUNTIME_OWNER_NAME=Ada

# Boards and documents (docs/integrations.md).
# RUNTIME_BOARDS_URL=https://boards.example.com
# RUNTIME_BOARDS_TOKEN=
# RUNTIME_BOARDS_AGENT_TOKEN=
# RUNTIME_ARTIFACTS_URL=https://artifacts.example.com
# RUNTIME_ARTIFACTS_TOKEN=
# RUNTIME_ARTIFACTS_READ_TOKEN=

# The password is chosen by whoever opens the page first. On a host others can reach, set this: the page then asks for
# it before it lets anyone choose the real one (docs/deploy.md, "The first visit").
# INIT_PASSWORD=
