# Environment of the harnessly hub system service (/etc/harnessly/hub.env, mode 0600: it holds secrets). Every
# variable is listed in .env.hub.example and explained in docs/hub/deploy.md. The hub reads this file as plain
# NAME=value lines: no export, no quotes needed, no spaces around =.

# The address people use, without a trailing slash. The only required setting. Put a TLS proxy in front.
HUB_PUBLIC_URL=https://hub.example.com

# open: anyone can create an account; invite: administrators and people with an invitation. Administrators must sign
# in with an address they have proved. Empty admins: the first account to sign in is the administrator (and it has to
# prove its address as well): name them on any server others can reach.
# HUB_SIGNUP=open
# HUB_ADMIN_EMAILS=you@example.com

# Mail for sign-in codes and invitations. Without it the code is written to the journal, marked DEV.
# HUB_SMTP_URL=smtp://user:password@mail.example.com:587
# HUB_MAIL_FROM=harnessly <no-reply@example.com>

# GitHub, Yandex ID and OpenID Connect (callbacks <HUB_PUBLIC_URL>/api/auth/oauth/<github|yandex|id>/callback).
# HUB_GITHUB_CLIENT_ID=
# HUB_GITHUB_CLIENT_SECRET=
# HUB_YANDEX_CLIENT_ID=
# HUB_YANDEX_CLIENT_SECRET=
# HUB_OIDC_PROVIDERS=keycloak
# HUB_OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/team
# HUB_OIDC_KEYCLOAK_CLIENT_ID=harnessly
# HUB_OIDC_KEYCLOAK_CLIENT_SECRET=
# HUB_OIDC_KEYCLOAK_NAME=Corporate sign-in

# Machines at <machine>.<domain> (a wildcard record and certificate). Needed for anything shared (without it a
# machine's pages run on the hub's own origin: only machines you trust completely), and by the cloud edition. Use a
# domain of its own, not a sibling of the hub's (one registrable domain is one site: a warning at start, and a refusal
# in the cloud edition unless HUB_ALLOW_SAME_SITE_RUNTIME=1).
# HUB_RUNTIME_DOMAIN=run.example.net

# The SSH way: a key per space, sealed with HUB_SECRET_KEY (at least 32 characters; empty: a key file in the data
# folder). It refuses private addresses unless HUB_SSH_ALLOW_PRIVATE=on.
# HUB_SECRET_KEY=
# HUB_SSH_ALLOW_PRIVATE=off

# Postgres instead of the SQLite file in /var/lib/harnessly-hub.
# HUB_DATABASE_URL=postgres://harnessly:password@db.example.com:5432/harnessly?sslmode=require

# The proxy in front is on this host: its address is trusted for X-Forwarded-For (this is the default).
# HUB_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# HUB_LOG_LEVEL=info
